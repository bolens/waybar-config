# https://editorconfig.org
root = true

[*]
indent_style = space
indent_size = 2
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{sh,bash}]
indent_style = space
indent_size = 2

[*.{yml,yaml,json,jsonc,css,mjs,md}]
indent_style = space
indent_size = 2

[*.{md,mdx}]
trim_trailing_whitespace = false

[*.py]
indent_style = space
indent_size = 4

[{Makefile,makefile,GNUmakefile,*.mk}]
indent_style = tab
indent_size = tab

# Lockfiles are written by their owning tool.
[pnpm-lock.yaml]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset
